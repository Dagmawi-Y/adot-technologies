---
import ResponsiveImage from '@/components/site/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/site/Icon.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import ServiceCard from '@/components/site/ServiceCard.astro';
import ProjectCard from '@/components/site/ProjectCard.astro';
import ArticleCard from '@/components/site/ArticleCard.astro';
import TeamSection from '@/components/site/TeamSection.astro';
import { questions, clients } from '@/data/site';
const [allServices, allProjects, allArticles] = await Promise.all([getCollection('services'), getCollection('projects'), getCollection('articles')]);
const services = allServices.sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const articles = allArticles.sort((a, b) => a.data.order - b.data.order);
const highlights = [{ title: 'Websites', text: 'Designed to connect' }, { title: 'Apps', text: 'Built around your users' }, { title: 'Software', text: 'Made for your business' }, { title: 'Ideas', text: 'Given room to grow' }];
---
<Layout>
  <section class="site-container hero">
    <div class="hero-heading flex items-start justify-between gap-8"><h1><span class="hero-line"><span>Your next big idea.</span></span>{' '}<span class="hero-line"><span>In good hands.</span></span></h1><div class="hero-clients"><div class="hero-client-logos">{clients.map(client => <ResponsiveImage src={client.logo} alt={client.name} loading="eager" sizes="40px" widths={[40, 80, 120]} />)}</div><p>Companies we’ve worked with.</p></div></div>
    <div class="hero-visual"><div class="hero-photo"><ResponsiveImage src="/images/office.png" alt="Adot Technologies office imagery" width="1792" height="1024" fetchpriority="high" loading="eager" style="object-position: center 65%" data-parallax /><div class="hero-photo-shade"></div><div class="hero-tags"><span class="tag-white">Powering bold dreams<span aria-hidden="true"><Icon name="star" size={15} /></span></span><span>Thoughtful design<span aria-hidden="true"><Icon name="star" size={15} /></span></span><span>Local people<span aria-hidden="true"><Icon name="star" size={15} /></span></span><span>Built around you<span aria-hidden="true"><Icon name="star" size={15} /></span></span><span>Ideas into impact<span aria-hidden="true"><Icon name="star" size={15} /></span></span></div></div><div class="hero-note"><span aria-hidden="true"><Icon name="star" size={15} /></span><p>Websites, mobile apps, and custom software for teams across Africa. Built in Addis Ababa, with care for your next chapter.</p></div><a class="contact-seal" href="/contact/" aria-label="Let’s talk about your idea"><svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="seal-path" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" /></defs><text><textPath href="#seal-path" textLength="218">GET IN TOUCH · GET IN TOUCH · </textPath></text></svg><Icon name="down" size={26} /></a></div>
    <div class="stats-grid grid grid-cols-2 md:grid-cols-4">{highlights.map(item => <div data-reveal><strong>{item.title}</strong><p>{item.text}</p></div>)}</div>
  </section>
  <section class="site-container section services-section" id="services"><div class="section-heading text-center" data-reveal><h2>Whatever’s next, let’s build it right.</h2><p>A fresh start or a bigger ambition. We’re here to help.</p></div><div class="service-grid grid gap-5 md:grid-cols-3">{services.map(service => <ServiceCard service={service} />)}</div></section>
  <section class="site-container section about-block" id="about"><div class="about-intro" data-reveal><h2 class="whitespace-pre-line">Rooted in Ethiopia.<br />Built for possibility.</h2><p>We’re designers, developers, and problem-solvers based in Addis Ababa, building useful technology for people and businesses across Africa.</p><LinkButton href="/about/">Find out more</LinkButton></div><div class="about-images"><a href="/about/" class="craft-image" aria-label="Meet Adot Technologies"><ResponsiveImage src="/images/generated/workspace.jpg" alt="A laptop and notebook on a worktable beside a window" width="1122" height="1402" loading="lazy" /><span class="round-arrow"><Icon /></span></a><figure class="planning-image"><ResponsiveImage src="/images/generated/collaboration.jpg" alt="Two collaborators reviewing a laptop and project notes" width="1536" height="1024" loading="lazy" /><figcaption>Good work starts with a conversation.</figcaption></figure></div></section>
  <section class="site-container reassurance" aria-label="What matters to us" data-reveal><p>Thoughtful work. From the very beginning.</p><div class="grid grid-cols-2 gap-6 md:grid-cols-4">{[{ icon: 'pen', label: 'Considered design' }, { icon: 'chat', label: 'Clear communication' }, { icon: 'people', label: 'A collaborative team' }, { icon: 'check', label: 'Practical solutions' }].map(item => <div><Icon name={item.icon} size={25} /><span>{item.label}</span></div>)}</div></section>
  <TeamSection />
  <section class="site-container section" id="projects"><div class="section-heading heading-row" data-reveal><div><h2>Bold ideas. Brought to life.</h2><p>A few of the websites and systems in our portfolio.</p></div><LinkButton href="/projects/">See our work</LinkButton></div><div class="project-grid grid gap-6 md:grid-cols-3">{projects.map(project => <ProjectCard project={project} />)}</div></section>
  <section class="site-container section estimate-section"><div class="section-heading text-center" data-reveal><span class="small-marker" aria-hidden="true"><Icon name="star" size={24} /></span><h2>A good project starts with a clear plan.</h2><p>Your goals come first. Let’s find the right way forward.</p></div><div class="estimate-grid grid gap-6 md:grid-cols-2">{[{ dark: true, label: 'Your business. Online.', title: 'A place to make your mark', description: 'For a new website or a fresh look at your existing one.', features: ['A conversation about your business', 'Design that reflects your identity', 'A responsive experience for your visitors', 'A clear scope before development'], service: 'web-development', action: 'Let’s talk websites' }, { dark: false, label: 'Your idea. One team.', title: 'Something a little bigger', description: 'For mobile apps and software built around your business.', features: ['An initial project conversation', 'A closer look at your requirements', 'A user experience with a purpose', 'Development shaped around your goals'], service: 'custom-software', action: 'Let’s plan your project' }].map(option => <article class:list={['estimate-card', { 'estimate-dark': option.dark }]} data-reveal><svg class="estimate-shape" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true"><path vector-effect="non-scaling-stroke" d="M22 1H92L156 24H378Q399 24 399 46V378Q399 399 378 399H22Q1 399 1 378V22Q1 1 22 1Z" /></svg><div class="estimate-label">{option.label}</div><h3>{option.title}</h3><p>{option.description}</p><ul>{option.features.map(feature => <li><Icon name="check" size={15} />{feature}</li>)}</ul><LinkButton href={`/contact/?service=${option.service}`} variant={option.dark ? 'orange' : 'dark'}>{option.action}</LinkButton></article>)}</div></section>
  <section class="site-container section blog-preview"><div class="section-heading heading-row" data-reveal><div><h2>A little know-how goes a long way.</h2><p>Ideas and perspectives from the Adot journal.</p></div><LinkButton href="/blog/">All articles</LinkButton></div><div class="blog-grid">{articles.map(article => <ArticleCard article={article} />)}</div></section>
  <section id="questions" class="site-container section faq-section"><h2 data-reveal>A few things you might be wondering.</h2><div>{questions.map(item => <details class="faq-item" data-reveal><summary>{item.question}<Icon name="plus" size={19} /></summary><p>{item.answer}</p></details>)}</div></section>
</Layout>
