---
import ResponsiveImage from '@/components/site/ResponsiveImage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import ServiceCard from '@/components/site/ServiceCard.astro';
import Icon from '@/components/site/Icon.astro';
import { canonicalUrl, organizationId } from '@/lib/seo';
export async function getStaticPaths() { return (await getCollection('services')).map(service => ({ params: { id: service.id }, props: { service } })); }
interface Props { service: CollectionEntry<'services'>; }
const { service: { id, data } } = Astro.props;
const others = (await getCollection('services')).filter(service => service.id !== id).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('articles')).filter(article => data.guideSlugs.includes(article.data.slug));
const serviceSchema = { '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonicalUrl(`/services/${id}/`)}#service`, name: data.title, serviceType: data.title, description: data.seoDescription, url: canonicalUrl(`/services/${id}/`), provider: { '@id': organizationId }, areaServed: { '@type': 'Continent', name: 'Africa' } };
---
<Layout title={data.title} seoTitle={data.seoTitle} description={data.seoDescription} image={data.image} imageAlt={data.imageAlt}><script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema).replace(/</g, '\\u003c')} /><PageIntro title={data.title} description={data.intro} backHref="/services/" backLabel="All services" /><div class="site-container detail-hero"><ResponsiveImage src={data.image} alt={data.imageAlt} width="1200" height="800" fetchpriority="high" loading="eager" sizes="(min-width: 1100px) 700px, (min-width: 768px) 58vw, calc(100vw - 28px)" /><aside><h2>The right approach. Every detail.</h2><ul>{data.features.map(feature => <li><Icon name="check" size={18} />{feature}</li>)}</ul><LinkButton href={`/contact/?service=${id}`} variant="accent">Let’s talk about it</LinkButton></aside></div><section class="site-container section story-grid"><h2>What this can help you build.</h2><ul class="scope-list">{data.useCases.map(item => <li><Icon name="check" size={18} />{item}</li>)}</ul></section><section class="site-container section"><div class="section-heading"><h2>A clear path from idea to launch.</h2></div><div class="process-grid grid gap-6 md:grid-cols-3">{data.process.map((step, index) => <article data-reveal><span class="process-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div></section><section class="site-container section faq-section"><h2>A clearer starting point.</h2><div>{data.questions.map(item => <details class="faq-item"><summary>{item.question}<Icon name="plus" size={19} /></summary><p>{item.answer}</p></details>)}</div></section><section class="site-container section story-grid"><h2>Useful before you brief.</h2><ul class="service-guide-links">{guides.map(article => <li><a class="inline-link" href={`/blog/${article.data.slug}/`}>{article.data.title}</a><p>{article.data.description}</p></li>)}</ul></section><section class="site-container section"><div class="section-heading heading-row"><div><h2>Something else in mind?</h2><p>Explore the other ways we can help.</p></div><LinkButton href="/services/">All services</LinkButton></div><div class="service-grid grid gap-5 md:grid-cols-3">{others.map(service => <ServiceCard service={service} fullTitle />)}</div></section></Layout>
