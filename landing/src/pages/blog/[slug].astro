---
import ResponsiveImage from '@/components/site/ResponsiveImage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/site/Icon.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import ArticleCard from '@/components/site/ArticleCard.astro';
import { articleReadingTime, formatArticleDate } from '@/lib/articles';
import { site } from '@/data/site';
import { organizationId } from '@/lib/seo';

export async function getStaticPaths() {
  return (await getCollection('articles')).map(article => ({
    params: { slug: article.data.slug }, props: { article },
  }));
}
interface Props { article: CollectionEntry<'articles'>; }
const { article: { id, data } } = Astro.props;
const related = (await getCollection('articles')).filter(article => article.id !== id).sort((a, b) => a.data.order - b.data.order);
const url = new URL(`/blog/${data.slug}/`, site.url).href;
const published = `${data.date}T00:00:00+03:00`;
const modified = `${data.updatedDate ?? data.date}T00:00:00+03:00`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting', '@id': `${url}#article`, mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      headline: data.title, description: data.description, image: new URL(data.image, site.url).href,
      datePublished: published, dateModified: modified, inLanguage: 'en',
      author: { '@type': 'Organization', '@id': organizationId, name: site.name, url: site.url },
      publisher: { '@id': organizationId },
      citation: [...new Set(data.sections.flatMap(section => section.sources?.map(source => source.url) ?? []))],
    },
  ],
};
---
<Layout title={data.title} seoTitle={data.seoTitle} description={data.description} image={data.image} imageAlt={data.imageAlt} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </Fragment>
  <header class="site-container page-intro article-intro">
    <a class="text-link" href="/blog/"><Icon name="arrow" size={15} />All articles</a>
    <h1>{data.title}</h1>
    <p>{data.description}</p>
    <div class="article-meta">
      <span>{data.category}</span>
      <a class="inline-link" href="/about/">By {site.name}</a>
      <time datetime={data.date}>{formatArticleDate(data.date)}</time>
      <span>{articleReadingTime(data)}</span>
      {data.updatedDate && <span>Updated <time datetime={data.updatedDate}>{formatArticleDate(data.updatedDate)}</time></span>}
    </div>
  </header>
  <figure class="site-container article-hero"><ResponsiveImage src={data.image} alt={data.imageAlt} width="1200" height="600" fetchpriority="high" loading="eager" /></figure>
  <div class="site-container article-layout">
    <aside class="article-aside">
      <nav aria-label="In this article">
        <p>In this article</p>
        {data.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
      </nav>
    </aside>
    <article class="article-body" aria-label={data.title}>
      {data.sections.map(section => <section id={section.id} aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`}>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
        {section.steps && <ol>{section.steps.map(step => <li>{step}</li>)}</ol>}
        {section.table && <figure class="article-comparison">
          <figcaption id={`${section.id}-table-caption`}>{section.table.caption}</figcaption>
          <div class="article-table-scroll" role="region" aria-labelledby={`${section.id}-table-caption`} tabindex="0">
          <table class="article-table" aria-labelledby={`${section.id}-table-caption`}>
            <thead><tr>{section.table.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
            <tbody>{section.table.rows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
          </table>
          </div>
        </figure>}
        {section.sources && <p class="article-sources">Sources: {section.sources.map((source, index) => <>{index > 0 && '; '}<a href={source.url}>{source.label}</a></>)}.</p>}
        {section.links && <ul class="article-links">{section.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
      </section>)}
      <section class="article-cta" aria-labelledby="article-project-title">
        <h2 id="article-project-title">Have a project in mind?</h2>
        <p>A first conversation can help turn a good idea into a clear next step. Tell us what you’re working on.</p>
        <LinkButton href="/contact/" variant="dark">Let’s talk about it</LinkButton>
      </section>
    </article>
  </div>
  <section class="site-container section">
    <div class="section-heading heading-row"><h2>A few more useful reads.</h2><LinkButton href="/blog/">All articles</LinkButton></div>
    <div class="blog-grid">{related.map(article => <ArticleCard article={article} />)}</div>
  </section>
</Layout>
