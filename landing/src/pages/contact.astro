---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import Icon from '@/components/site/Icon.astro';
import { site } from '@/data/site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Let’s talk" description="Tell Adot Technologies about your next website, app, or custom software project. Contact our team in Addis Ababa."><PageIntro title="Let’s make something good happen." description="A new website, a big idea, or a question about where to start. We’d love to hear it." /><section class="site-container contact-layout"><aside><h2>Talk to a real person.</h2><div><span>Give us a call</span><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href="tel:+251937466731">{site.secondPhone}</a></div><div><span>Drop us a line</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div><span>Find us</span><p>{site.address}</p></div><img src="/images/office.png" alt="Adot Technologies office imagery" width="1792" height="1024" loading="lazy" /></aside><form data-contact-form method="post" action="/api/contact"><h2>Tell us a little about your project.</h2><div class="form-fields"><label class="form-label"><span>Your name</span><input type="text" name="name" required autocomplete="name" maxlength="120" /></label><label class="form-label"><span>Email address</span><input type="email" name="email" required autocomplete="email" maxlength="254" /></label><label class="form-label"><span>Phone number (optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="40" /></label><label class="form-label"><span>Company (optional)</span><input type="text" name="company" autocomplete="organization" maxlength="120" /></label><label class="form-label field-wide"><span>What can we help with?</span><select name="service" required><option value="" disabled selected>Choose a service</option>{services.map(service => <option value={service.id}>{service.data.title}</option>)}<option value="other">Something else</option></select></label><label class="form-label field-wide"><span>A little about your project</span><textarea name="message" required placeholder="What are you planning, and what would you like to achieve?" maxlength="5000" rows="5"></textarea></label></div><div class="honeypot" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div><input type="hidden" name="requestId" value="" /><p class="privacy-note">Your details are used to respond to your enquiry. <a href="#privacy">Privacy notice</a></p><button class="button button-orange" type="submit"><span data-submit-label>Send your enquiry</span><Icon size={16} /></button><p class="form-feedback" role="status" aria-live="polite" tabindex="-1"></p><noscript><p class="form-note">You can submit this form without JavaScript, or contact us directly by phone or email.</p></noscript></form></section><section id="privacy" class="site-container contact-privacy"><h2>Your enquiry, handled with care.</h2><p>This form sends the details you provide to Adot Technologies through Resend so our team can reply. Please share only information relevant to your project. For questions about your enquiry or your data, contact <a class="inline-link" href={`mailto:${site.email}`}>{site.email}</a>.</p></section></Layout>
