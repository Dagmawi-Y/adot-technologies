---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import ProjectCard from '@/components/site/ProjectCard.astro';
import { site } from '@/data/site';
export async function getStaticPaths() { return (await getCollection('projects')).map(project => ({ params: { id: project.id }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project: { id, data } } = Astro.props;
const related = (await getCollection('projects')).filter(project => project.id !== id).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={data.title} description={data.description} image={data.image}><PageIntro title={data.title} description={data.description} backHref="/projects/" backLabel="All projects" /><figure class="site-container project-screenshot"><img src={data.image} alt={data.imageAlt} width="1600" height="1200" fetchpriority="high" /></figure><section class="site-container section story-grid"><h2>{id === 'adot-erp' ? 'A system for the everyday.' : 'A business, brought online.'}</h2><div><p>{data.overview}</p><dl class="project-facts"><div><dt>Client</dt><dd>{data.client}</dd></div><div><dt>Service</dt><dd><a class="inline-link" href={`/services/${data.service}/`}>{data.category}</a></dd></div></dl>{id === 'adot-erp' && <p><a class="inline-link" href={site.products}>Explore Adot’s products</a></p>}<LinkButton href={`/contact/?service=${data.service}`} variant="dark">Have something in mind?</LinkButton></div></section><section class="site-container section"><div class="section-heading"><h2>A little more of our work.</h2></div><div class="project-grid grid gap-6 md:grid-cols-2">{related.map(project => <ProjectCard project={project} />)}</div></section></Layout>
