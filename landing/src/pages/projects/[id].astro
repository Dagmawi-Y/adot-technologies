---
import ResponsiveImage from '@/components/site/ResponsiveImage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import ProjectCard from '@/components/site/ProjectCard.astro';
import Icon from '@/components/site/Icon.astro';
import { site } from '@/data/site';
import { canonicalUrl, organizationId } from '@/lib/seo';
export async function getStaticPaths() { return (await getCollection('projects')).map(project => ({ params: { id: project.id }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project: { id, data } } = Astro.props;
const related = (await getCollection('projects')).filter(project => project.id !== id).sort((a, b) => a.data.order - b.data.order);
const projectSchema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  '@id': `${canonicalUrl(`/projects/${id}/`)}#project`,
  name: data.title, description: data.overview,
  url: canonicalUrl(`/projects/${id}/`),
  creator: { '@id': organizationId },
  mainEntityOfPage: { '@id': canonicalUrl(`/projects/${id}/`) },
  about: { '@type': 'Service', name: data.category, url: canonicalUrl(`/services/${data.service}/`), provider: { '@id': organizationId } },
};
---
<Layout title={data.title} seoTitle={`${data.title} | ${data.category}`} description={`${data.description} Explore the project overview and scope in Adot Technologies’ website and software portfolio.`} image={data.image} imageAlt={data.imageAlt}><script slot="head" type="application/ld+json" set:html={JSON.stringify(projectSchema).replace(/</g, '\\u003c')} /><PageIntro title={data.title} description={data.description} backHref="/projects/" backLabel="All projects" /><figure class="site-container project-screenshot"><ResponsiveImage src={data.image} alt={data.imageAlt} width="1600" height="1200" fetchpriority="high" loading="eager" /></figure><section class="site-container section story-grid"><h2>{id === 'adot-erp' ? 'A system for the everyday.' : 'A business, brought online.'}</h2><div><p>{data.overview}</p><div class="project-scope"><h3>The work</h3><ul class="scope-list">{data.scope.map(item => <li><Icon name="check" size={18} />{item}</li>)}</ul></div><dl class="project-facts"><div><dt>Built by</dt><dd><a class="inline-link" href="/about/">{site.name}</a>, Addis Ababa, Ethiopia</dd></div><div><dt>Client</dt><dd>{data.client}</dd></div><div><dt>Service</dt><dd><a class="inline-link" href={`/services/${data.service}/`}>{data.category}</a></dd></div></dl>{id === 'adot-erp' && <p><a class="inline-link" href={site.products}>Explore Adot’s products</a></p>}<LinkButton href={`/contact/?service=${data.service}`} variant="primary">Have something in mind?</LinkButton></div></section><section class="site-container section"><div class="section-heading"><h2>A little more of our work.</h2></div><div class="project-grid grid gap-6 md:grid-cols-2">{related.map(project => <ProjectCard project={project} />)}</div></section></Layout>
