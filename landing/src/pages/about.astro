---
import ResponsiveImage from '@/components/site/ResponsiveImage.astro';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import TeamSection from '@/components/site/TeamSection.astro';
import LinkButton from '@/components/site/LinkButton.astro';
import Icon from '@/components/site/Icon.astro';
import { site } from '@/data/site';
const values = [{ title: 'Innovation & excellence', description: 'Creating useful technology and taking care with the details that make it work.', icon: 'code' }, { title: 'Integrity & collaboration', description: 'Working openly and building shared success with our clients and partners.', icon: 'chat' }, { title: 'Empowerment & impact', description: 'Making technology accessible and helping people turn their ideas into something useful.', icon: 'people' }];
---
<Layout title="About Adot Technologies" seoTitle="About Our Software Company in Addis Ababa" description="Meet Adot Technologies, a software company in Addis Ababa, Ethiopia, building websites, mobile apps, and custom software for businesses across Africa.">
  <PageIntro title="Local people. A bigger possibility." description="We started with a shared belief: technology should help people move forward. That idea still shapes everything we build." />
  <div class="site-container wide-photo"><ResponsiveImage src="/images/generated/collaboration.jpg" alt="Two collaborators reviewing a laptop and project notes" width="1536" height="1024" fetchpriority="high" loading="eager" /></div>
  <section class="site-container section story-grid"><h2>Built to serve.<br />Ready to create.</h2><div><p>Adot Technologies is an Ethiopian technology company creating websites, mobile apps, and custom software. Based in Addis Ababa, we work with startups, businesses, educational institutions, and government agencies across Africa.</p><p>Our mission is to solve community challenges through useful technology. Our vision is to become a trusted technology partner across Africa, making digital tools more accessible and affordable.</p></div></section>
  <section class="site-container values-grid grid gap-6 md:grid-cols-3">{values.map(value => <article data-reveal><span class="value-icon"><Icon name={value.icon} size={23} /></span><h3>{value.title}</h3><p>{value.description}</p></article>)}</section>
  <TeamSection showLink={false} />
  <section class="site-container section story-grid"><h2>A shared passion.<br />A purposeful start.</h2><div class="company-timeline"><article data-reveal><span>2023</span><h3>It started on campus.</h3><p>Two friends met through the Techtonic Tribe campus club, sharing their interest in technology and teaching other students computing skills.</p></article><article data-reveal><span>2024</span><h3>Adot Technologies takes shape.</h3><p>After graduation, that collaboration became Adot Technologies. The company launched with a commitment to service, innovation, and “Powering Bold Dreams.”</p></article><article data-reveal><span>What comes next</span><h3>Room for new ideas.</h3><p>Through Adot Labs, we support startups and tech enthusiasts with incubation and funding, helping them develop their ideas.</p><p><a class="inline-link" href={site.labs}>Explore Adot Labs</a></p></article></div></section>
  <section class="site-container section detail-hero"><ResponsiveImage src="/images/generated/mentoring.jpg" alt="A mentoring conversation about an idea sketched in a notebook" width="1536" height="1024" loading="lazy" /><aside><h2>Big ideas need a place to begin.</h2><p class="empty-space-note">Adot Labs is a space for innovation, collaboration, and the people building what comes next.</p><ul class="scope-list"><li><Icon name="check" />Incubating new ideas</li><li><Icon name="check" />Supporting emerging innovators</li><li><Icon name="check" />Building for local challenges</li></ul><LinkButton href={site.labs} variant="accent">Discover Adot Labs</LinkButton></aside></section>
</Layout>
