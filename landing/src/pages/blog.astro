---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/site/PageIntro.astro';
import ArticleCard from '@/components/site/ArticleCard.astro';
const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Technology guides for African businesses" description="Practical technology guides for African businesses: compare websites and apps, choose ERP or custom software, and understand website costs in Ethiopia."><PageIntro title="A little know-how goes a long way." description="Practical guides to choosing, budgeting for, and running the technology your business needs." /><section class="site-container"><div class="blog-grid">{articles.map(article => <ArticleCard article={article} />)}</div></section></Layout>
