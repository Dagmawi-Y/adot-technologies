---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { service: CollectionEntry<'services'>; fullTitle?: boolean; }
const { service, fullTitle = false } = Astro.props;
const { data, id } = service;
const title = fullTitle ? data.title : data.shortTitle;
---
<div class="service-stage" data-reveal><article class="service-card"><div class="service-default"><span class="service-icon"><Icon name={data.icon} size={24} /></span><h3>{title}</h3><p>{data.description}</p></div><div class="service-hover" aria-hidden="true"><span class="service-hover-title">{title}</span><p>{data.description}</p></div><a class="service-link" href={`/services/${id}/`}>Explore {data.title.toLowerCase()}<Icon name="arrow" size={15} /></a><span class="service-sheen" aria-hidden="true"></span></article></div>
