---
interface Props { footer?: boolean; }
const { footer = false } = Astro.props;
---
<a class:list={['brand', { 'brand-footer': footer }]} href="/" aria-label="Adot Technologies home"><svg class="brand-mark adot-mark" width="32" height="32" viewBox="145 103 804 876" aria-hidden="true"><image href="/images/adot-logo.png?v=2" width="1080" height="1080" /></svg><span>{footer ? 'Adot Technologies' : 'Adot'}<span class="brand-dot">.</span></span></a>
