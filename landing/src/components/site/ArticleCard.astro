---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { article: CollectionEntry<'articles'>; }
const { article: { data } } = Astro.props;
const date = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(data.date));
---
<article class="blog-card" data-reveal><a class="blog-card-link" href={data.source}><div class="blog-image"><img src={data.image} alt={data.imageAlt} width="1000" height="667" loading="lazy" /><span class="blog-category">{data.category}</span></div><div class="blog-card-content"><div class="blog-meta"><time datetime={data.date}>{date}</time><span>Adot journal</span></div><h3>{data.title}</h3><span class="blog-read">Read the article<span class="blog-arrow"><Icon size={18} /></span></span></div></a></article>
