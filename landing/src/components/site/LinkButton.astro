---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'outline' | 'accent' | 'white'; class?: string; }
const { href, variant = 'outline', class: className } = Astro.props;
---
<a href={href} class:list={['button', `button-${variant}`, className]}><span class="button-label"><slot /></span><span class="button-icon" aria-hidden="true"><Icon size={16} /><Icon size={16} class="button-icon-copy" /></span></a>
